generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Transmission {
  automatic
  manual
}

enum FuelType {
  petrol
  diesel
  hybrid
  electric
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String?        @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  bookings      Booking[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cars      Car[]

  @@map("categories")
}

model Car {
  id             String       @id @default(uuid(7)) @db.Uuid
  brand          String
  pricePerDay    Decimal      @map("price_per_day") @db.Decimal(10, 2)
  transmission   Transmission
  fuel           FuelType
  airConditioner Boolean      @default(true) @map("air_conditioner")
  doors          Int
  seats          Int
  mileageLimitKm Int          @map("mileage_limit_km")
  equipment      String[]
  image          String
  gallery        String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  categoryId     String       @map("category_id") @db.Uuid
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings       Booking[]

  @@index([categoryId])
  @@map("cars")
}

model Booking {
  id            String        @id @default(uuid(7)) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  carId         String        @map("car_id") @db.Uuid
  placeOfRental String        @map("place_of_rental")
  placeOfReturn String        @map("place_of_return")
  rentalDate    DateTime      @map("rental_date") @db.Date
  returnDate    DateTime      @map("return_date") @db.Date
  totalPrice    Decimal       @map("total_price") @db.Decimal(10, 2)
  status        BookingStatus @default(pending)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  car      Car       @relation(fields: [carId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([carId, rentalDate, returnDate])
  @@index([userId])
  @@map("bookings")
}

model Payment {
  id                    String        @id @default(uuid(7)) @db.Uuid
  bookingId             String        @map("booking_id") @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("USD") @db.Char(3)
  method                String?
  stripePaymentIntentId String?       @unique @map("stripe_payment_intent_id")
  status                PaymentStatus @default(pending)
  paidAt                DateTime?     @map("paid_at")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("payments")
}
