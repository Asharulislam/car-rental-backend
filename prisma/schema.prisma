generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Transmission {
  automatic
  manual
}

enum FuelType {
  petrol
  diesel
  hybrid
  electric
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String?        @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]

  @@map("users")
}

// One row per issued refresh token. userId is null for the admin, who has no users row.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cars      Car[]

  @@map("categories")
}

model Car {
  id             String       @id @default(uuid(7)) @db.Uuid
  brand          String
  pricePerDay    Decimal      @map("price_per_day") @db.Decimal(10, 2)
  transmission   Transmission
  fuel           FuelType
  airConditioner Boolean      @default(true) @map("air_conditioner")
  doors          Int
  seats          Int
  mileageLimitKm Int          @map("mileage_limit_km")
  equipment      String[]
  image          String
  gallery        String[]
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  categoryId     String       @map("category_id") @db.Uuid
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@map("cars")
}
